APP_NAME=JARVIS-Hermes Assistant Backend
APP_ENV=production
HOST=0.0.0.0
PORT=8000

# AWS Config
AWS_REGION=us-east-1

# Hermes Mode: auto | hermes_cli | hermes_gateway | nvidia_nim
HERMES_MODE=auto
HERMES_GATEWAY_URL=http://127.0.0.1:8080
HERMES_BIN_PATH=hermes

# NVIDIA NIM API Key (Keep secret!)
NVIDIA_API_KEY=
NVIDIA_DEFAULT_MODEL=meta/llama-3.3-70b-instruct
